# M.I.R.A. (Middleware for Integration and Real-time Automation)
# Environment Configuration Template

# Server Settings
APP_NAME="M.I.R.A. Middleware"
APP_ENV="development"
DEBUG=True
LOG_LEVEL="INFO"
HOST="0.0.0.0"
PORT=8000

# Monday.com API Configuration
MONDAY_API_KEY="your_monday_api_key_here"
MONDAY_BOARD_ID="your_monday_board_id_here"

# Xero API & OAuth2 Configuration
XERO_CLIENT_ID="your_xero_client_id_here"
XERO_CLIENT_SECRET="your_xero_client_secret_here"
XERO_REDIRECT_URI="http://localhost:8000/callback"
XERO_TENANT_ID="your_xero_tenant_id_here"
